{
  "name": "lira",
  "version": "1.1.218",
  "description": "Lira - Espaço Virtual e Comunicação em Tempo Real",
  "main": "out/main.js",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@electron/asar": "$@electron/asar",
    "global-agent": "4.1.3",
    "temp": {
      "rimraf": "file:../../packages/compat/temp-rimraf"
    },
    "fetch-blob": {
      "node-domexception": "file:../../packages/compat/native-domexception"
    },
    "png-chunks-encode": {
      "sliced": "file:../../packages/compat/native-slice"
    },
    "@huggingface/transformers": {
      "sharp": "0.35.5"
    },
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18",
      "@excalidraw/mermaid-to-excalidraw": "3.6.0"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "app-builder-lib": {
      "minimatch": "11.0.9"
    },
    "@electron/universal": {
      "minimatch": "11.0.9"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "onnxruntime-node@1.21.0": true,
    "protobufjs@7.6.6": true
  },
  "scripts": {
    "test": "vitest run src/__tests__ --maxWorkers=8",
    "test:all": "node scripts/test-all.mjs",
    "teste:all": "npm run test:all",
    "test:migration": "python scripts/test_migrate_individual_library.py",
    "test:core": "vitest run src/__tests__/p2p src/__tests__/media",
    "test:e2e": "cross-env LIRA_RUN_SYSTEM_E2E=1 node --test --test-force-exit scripts/system.e2e.test.mjs",
    "test:e2e:visible": "cross-env LIRA_E2E_HEADED=1 npm run test:e2e",
    "test:dependencies:browser": "cross-env LIRA_RUN_DEPENDENCY_TESTS=1 node --test scripts/dependency-compatibility.browser.test.mjs",
    "test:whiteboard:browser": "cross-env LIRA_RUN_WHITEBOARD_TESTS=1 node --test scripts/whiteboard-editor.browser.test.mjs",
    "test:transcription:map": "cross-env LIRA_RUN_SPACE_TRANSCRIPTION_TESTS=1 node --test scripts/space-transcription.browser.test.mjs",
    "test:core:browser": "cross-env LIRA_RUN_BROWSER_TESTS=1 node --test --test-force-exit scripts/core-realtime.browser.test.mjs scripts/chat-scroll.browser.test.mjs",
    "test:navigation:browser": "cross-env LIRA_RUN_NAVIGATION_TESTS=1 node --test scripts/navigation-responsive.browser.test.mjs",
    "test:invites:electron": "cross-env LIRA_RUN_INVITE_TESTS=1 node --test scripts/space-invite.electron.test.mjs",
    "test:sprites:electron": "cross-env LIRA_RUN_SPRITE_TESTS=1 node --test scripts/individual-library.electron.test.mjs",
    "test:transcription:electron": "cross-env LIRA_RUN_TRANSCRIPTION_TESTS=1 node --test scripts/transcription-module.electron.test.mjs",
    "test:noise": "node scripts/noise-benchmark.mjs",
    "test:noise:dynamics": "node scripts/noise-benchmark.mjs --dynamics-only --output=node_modules/.cache/noise-dynamics-check",
    "dev": "cross-env LIRA_TARGET=web vite --open --strictPort",
    "preelectron:dev": "node scripts/check-dev-port.mjs",
    "electron:dev": "powershell -ExecutionPolicy Bypass -File scripts/build-process-audio.ps1 && vite --strictPort",
    "preelectron:dual": "node scripts/check-dev-port.mjs",
    "electron:dual": "concurrently -k -s first \"npm run electron:dev\" \"wait-on http://localhost:5173 out/main.js out/preload.js && cross-env INSTANCE=2 VITE_DEV_SERVER_URL=http://localhost:5173 electron . --instance=2\"",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build-process-audio.ps1 && node scripts/prepare-gstreamer-runtime.cjs && tsc && vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@electron/asar": "4.3.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@huggingface/transformers": "3.8.1",
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@jridgewell/trace-mapping": "0.3.31",
    "@lofcz/deepfilternet-web": "0.1.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.12",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "42.11.18",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "6.2.8",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "jsdom": "31.0.1",
    "lucide-react": "^0.475.0",
    "mqtt": "5.16.1",
    "peer": "^1.0.2",
    "peerjs": "^1.5.4",
    "playwright": "^1.64.1",
    "postcss": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "7.8.6",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "6.4.6",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "4.1.12",
    "wait-on": "^8.0.2",
    "zod": "4.6.7",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "com.lira.app",
    "productName": "Lira",
    "protocols": [
      {
        "name": "Convite para um espaço Lira",
        "schemes": [
          "lira"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "out/*.{js,mjs,cjs,map}",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".scratch/gstreamer-runtime",
        "to": "gstreamer"
      },
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "process-audio-capture.exe"
        ]
      }
    ],
    "win": {
      "electronLanguages": [
        "pt-BR",
        "en-US"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "include": "build/installer.nsh",
      "script": ".scratch/windows-installer/installer.nsi"
    },
    "publish": null,
    "afterPack": "scripts/verify-production-package.cjs",
    "artifactBuildStarted": "scripts/windows-update-package.cjs"
  }
}
