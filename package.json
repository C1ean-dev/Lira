{
  "name": "gather-v2-clone",
  "version": "1.0.0",
  "description": "Lira - Espaço Virtual e Comunicação em Tempo Real",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:build": "powershell -ExecutionPolicy Bypass -File scripts/build-process-audio.ps1 || exit 0",
    "electron:dev": "npm run native:build && vite",
    "electron:dev:2": "cross-env INSTANCE=2 VITE_DEV_SERVER_URL=http://localhost:5173 electron . --instance=2",
    "electron:dev:3": "cross-env INSTANCE=3 VITE_DEV_SERVER_URL=http://localhost:5173 electron . --instance=3",
    "electron:dual": "concurrently -k -s first \"npm run electron:dev\" \"wait-on http://localhost:5173 && npm run electron:dev:2\"",
    "electron:3": "concurrently -k -s first \"npm run electron:dev\" \"wait-on http://localhost:5173 && npm run electron:dev:2\" \"wait-on http://localhost:5173 && npm run electron:dev:3\"",
    "electron:triple": "concurrently -k -s first \"npm run electron:dev\" \"wait-on http://localhost:5173 && npm run electron:dev:2\" \"wait-on http://localhost:5173 && npm run electron:dev:3\"",
    "electron:installed:dual": "powershell -ExecutionPolicy Bypass -File scripts/run-installed-dual.ps1",
    "electron:build": "npm run native:build && tsc && vite build && electron-builder"
  },
  "dependencies": {
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "peerjs": "^1.5.4",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.lira.app",
    "productName": "Lira",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "process-audio-capture.exe"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "include": "build/installer.nsh"
    },
    "publish": null
  }
}