{
  "name": "lira",
  "version": "1.1.117",
  "description": "Lira - Espaço Virtual e Comunicação em Tempo Real",
  "main": "out/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@electron/asar": "$@electron/asar",
    "global-agent": "4.1.3",
    "temp": {
      "rimraf": "file:../../packages/compat/temp-rimraf"
    },
    "fetch-blob": {
      "node-domexception": "file:../../packages/compat/native-domexception"
    }
  },
  "scripts": {
    "test": "vitest run src/__tests__",
    "test:all": "node scripts/test-all.mjs",
    "teste:all": "npm run test:all",
    "test:migration": "python scripts/test_migrate_individual_library.py",
    "test:core": "vitest run src/__tests__/p2p src/__tests__/media",
    "test:core:browser": "cross-env LIRA_RUN_BROWSER_TESTS=1 node --test --test-force-exit scripts/core-realtime.browser.test.mjs",
    "test:navigation:browser": "cross-env LIRA_RUN_NAVIGATION_TESTS=1 node --test scripts/navigation-responsive.browser.test.mjs",
    "test:sprites:electron": "cross-env LIRA_RUN_SPRITE_TESTS=1 node --test scripts/individual-library.electron.test.mjs",
    "test:transcription:electron": "cross-env LIRA_RUN_TRANSCRIPTION_TESTS=1 node --test scripts/transcription-module.electron.test.mjs",
    "dev": "cross-env LIRA_TARGET=web vite --open --strictPort",
    "electron:dev": "powershell -ExecutionPolicy Bypass -File scripts/build-process-audio.ps1 && vite --strictPort",
    "electron:dual": "concurrently -k -s first \"npm run electron:dev\" \"wait-on http://localhost:5173 out/main.js out/preload.js && cross-env INSTANCE=2 VITE_DEV_SERVER_URL=http://localhost:5173 electron . --instance=2\"",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build-process-audio.ps1 && tsc && vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@electron/asar": "4.3.1",
    "@huggingface/transformers": "3.8.1",
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@lofcz/deepfilternet-web": "0.1.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.475.0",
    "peer": "^1.0.2",
    "peerjs": "^1.5.4",
    "playwright": "^1.64.1",
    "postcss": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.2",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "com.lira.app",
    "productName": "Lira",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "out/*.{js,mjs,cjs,map}",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "process-audio-capture.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "include": "build/installer.nsh"
    },
    "publish": null,
    "afterPack": "scripts/verify-production-package.cjs"
  }
}
