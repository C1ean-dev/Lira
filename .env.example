# Credenciais temporárias Cloudflare emitidas pelo backend (sem token no cliente).
VITE_TURN_CREDENTIALS_URL=https://lira-signaling.onrender.com/turn/credentials

# Fallback Metered, tentado somente depois de P2P e Cloudflare.
# Confirme os hostnames no painel da sua conta; eles dependem do plano e da região.
VITE_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp

# Deixe as credenciais reais em .env.local ou nos secrets do GitHub Actions.
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
