# Copie para .env.release.local. Caminhos Windows usam /, inclusive entre aspas.
# Os valores do ambiente do Windows têm prioridade sobre este arquivo.
# LIRA_JAVA_HOME seleciona o JDK da publicação mesmo se JAVA_HOME apontar para outro.
LIRA_JAVA_HOME="C:/Program Files/Eclipse Adoptium/jdk-21"
ANDROID_HOME="C:/Users/SEU_USUARIO/AppData/Local/Android/Sdk"
# Use a MESMA chave das versões Android já distribuídas para permitir atualização.
# O padrão, se omitido, é android/app/lira-release.jks.
# LIRA_KEYSTORE_PATH="C:/chaves/lira-release.jks"
# LIRA_STORE_PASSWORD=
# LIRA_KEY_ALIAS=lira
# LIRA_KEY_PASSWORD=
# Reutilize os valores usados nos builds anteriores; os secrets do GitHub não são baixados.
# VITE_TURN_URLS=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
# VITE_TURN_CREDENTIALS_URL=
# Mesmo segredo configurado no serviço lira-signaling da Render (não use prefixo VITE_).
# Obrigatório para disponibilizar os instaladores no cache logo após publicar no GitHub.
# LIRA_UPDATE_PUBLISH_TOKEN=
